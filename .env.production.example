# ==============================================================================
# MENTRA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production)
# ==============================================================================

# Core Application URL (HTTPS in Production)
NEXT_PUBLIC_APP_URL=https://mentra.yourdomain.com
NODE_ENV=production

# Supabase Auth & PostgreSQL Persistence
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AES-256-GCM Token Encryption Secret (32-byte hex string)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Sovereign Background Cron & Scheduler Secret
CRON_SECRET=your-production-secure-cron-secret-32-chars

# AI Agent Core (Gemini / Anthropic / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=AIzaSy...your-production-gemini-key
AI_MODEL_FAST=gemini-1.5-flash
AI_MODEL_SMART=gemini-1.5-pro
AI_AGENT_RUNTIME_V2=false
AI_MAX_TOOL_STEPS=6

# ==============================================================================
# OPTIONAL CAPABILITY PROVIDERS & FEATURE FLAGS
# ==============================================================================

# Private Beta Mode (Restricts public signups)
PRIVATE_BETA_MODE=false

# Google Workspace OAuth Integration
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://mentra.yourdomain.com/api/integrations/google/callback

# WhatsApp Cloud API Integration
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-business-account-id
WHATSAPP_ACCESS_TOKEN=EAAG...your-meta-access-token
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac
WHATSAPP_API_VERSION=v19.0

# Sovereign Speech Engine (STT / TTS / Voice Coaching)
VOICE_ENABLED=false
SPEECH_PROVIDER=openai
SPEECH_API_KEY=sk-...your-openai-speech-key
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=tts-1
VOICE_AUDIO_RETENTION_DAYS=30

# Live Web Research Provider
RESEARCH_ENABLED=false
RESEARCH_PROVIDER=tavily
RESEARCH_API_KEY=tvly-...your-tavily-api-key

# Browser & Computer Automation Provider
BROWSER_AGENT_ENABLED=false
BROWSER_PROVIDER=browserless
BROWSER_API_KEY=your-browserless-api-key

# Sovereign Autonomy Controls
AUTONOMY_MODE=ASSISTED
AUTONOMY_MAX_STEPS=8
AUTONOMY_MAX_TOOL_CALLS=12
