MENTRA_BASE_URL=https://mentra.inkthreadhub.in
BRAIN_WORKER_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-the-same-cron-secret-used-by-mentra

WORKER_ID=mentra-brain-01
WORKER_USER_ID=
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_MS=60000

# Official Meta WhatsApp Cloud API is handled by the MENTRA web app.
# Keep this disabled for the production worker unless you intentionally choose
# the optional unofficial linked-device mode below.
WHATSAPP_WORKER_MODE=disabled

# Optional Baileys linked-device mode (unofficial WhatsApp Web protocol).
# Required only when WHATSAPP_WORKER_MODE=baileys.
SUPABASE_URL=https://your-mentra-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
MENTRA_REFRESH_TOKEN=
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_SELF_CHAT=true
