MENTRA_BASE_URL=https://your-mentra-domain.com
BRAIN_WORKER_SECRET=
# Choose one configured credential: secret, token, or Ed25519 signing key.
BRAIN_WORKER_PRIVATE_KEY_B64=
MENTRA_USER_ID=your-supabase-user-uuid
WHATSAPP_AUTH_STORE=remote
CRON_SECRET=replace-with-the-same-cron-secret-used-by-mentra

SUPABASE_URL=https://your-mentra-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
MENTRA_REFRESH_TOKEN=your-user-refresh-token

WORKER_ID=mentra-brain-01
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
SCHEDULER_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_MS=60000

# Who MENTRA replies to on WhatsApp. Everyone else is ignored.
# Numbers with country code, comma separated.
WHATSAPP_ALLOWED_NUMBERS=
# Reply in your own "Message yourself" chat on the linked account (true/false).
WHATSAPP_SELF_CHAT=true
