# ==============================================================================
# MENTRA PERSONAL AI OPERATING SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Supabase Auth & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Workspace OAuth Credentials (GCP Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3010/api/integrations/google/callback

# Token Encryption Key for AES-256-GCM (32-byte hex string)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Live Web Research Provider (Tavily / SerpAPI / Live Web)
RESEARCH_PROVIDER=tavily
RESEARCH_API_KEY=tvly-your-tavily-api-key

# Autonomous AI Agent Inference (Gemini / Anthropic / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-provider-api-key
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.8-flash
AI_MODEL_AGENT=gemini-3.8-flash
AI_MODEL_RESEARCH=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
# Optional separate key; falls back to AI_API_KEY
AI_EMBEDDING_API_KEY=
AI_MEMORY_V2=true
AI_AGENT_RUNTIME_V2=false
AI_MAX_TOOL_STEPS=6
# Optional local/private inference endpoint (Ollama-compatible)
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=qwen3:8b
AI_LOCAL_FAST_MODEL=qwen3:4b
AI_LOCAL_AGENT_MODEL=qwen3:8b
AI_LOCAL_TIMEOUT_MS=45000

# WhatsApp Business / Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=EAAG...your-meta-system-user-access-token
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac
WHATSAPP_API_VERSION=v19.0

# Sovereign Background Cron & Scheduler
CRON_SECRET=your-secure-cron-dispatcher-secret
# Persistent Brain Worker auth (server-only; same value in brain-worker/.env)
BRAIN_WORKER_SECRET=replace-with-a-long-random-secret
# Sovereign Speech Engine (STT / TTS / Voice Coaching)
SPEECH_PROVIDER=openai
SPEECH_API_KEY=your-speech-api-key
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=tts-1
VOICE_AUDIO_RETENTION_DAYS=30

# Controlled Browser & Computer-Use Automation
BROWSER_PROVIDER=browserless
BROWSER_API_KEY=your-browserless-api-key
COMPUTER_PROVIDER=anthropic_computer_use
COMPUTER_API_KEY=your-computer-use-api-key

# Sovereign Autonomy & Risk Controls
AUTONOMY_MODE=ASSISTED
AUTONOMY_MAX_STEPS=8
AUTONOMY_MAX_TOOL_CALLS=12


